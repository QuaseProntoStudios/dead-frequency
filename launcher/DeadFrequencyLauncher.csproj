<Project Sdk="Microsoft.NET.Sdk">
  <!-- Launcher do Dead Frequency: confere o último release no GitHub, baixa/atualiza o jogo e abre.
       Publicar: dotnet publish -c Release -r win-x64 (ou linux-x64) — sai um executável único. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeadFrequencyLauncher</AssemblyName>
    <RootNamespace>DeadFrequencyLauncher</RootNamespace>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
