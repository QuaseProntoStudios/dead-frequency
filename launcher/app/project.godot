; Launcher do Dead Frequency (projeto Godot separado, só GDScript).
; Baixa e atualiza o jogo pelos releases do GitHub. Exportado pelo CI com os templates padrão.

config_version=5

[application]

config/name="Dead Frequency Launcher"
config/description="Instala e atualiza o Dead Frequency pelo GitHub."
config/version="1.1.0"
run/main_scene="res://launcher.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[display]

window/size/viewport_width=760
window/size/viewport_height=460
window/size/resizable=false
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
